# Pasta no teu PC onde os downloads vão ser guardados
DOWNLOAD_DIR=/home/o-teu-user/Downloads/1fichier

# As chaves e os limites ficam em config/settings.yaml (editável à mão ou em ⚙ Definições; não vai para o git).
# As variáveis abaixo são só valores iniciais, usados enquanto o settings.yaml não definir o mesmo valor.

# API key do 1fichier (Parâmetros -> API)
FICHIER_API_KEY=

# Opcional: chave da API do TMDB (themoviedb.org -> Definições -> API) para pesquisar nome/ano das séries
TMDB_API_KEY=

# Opcional: pasta mais acima onde a app deixa escolher o destino (botão "Alterar"). Vazia = opção escondida.
# Dá ao container permissão de escrita nesta pasta; escolhe a mais estreita possível.
SELECTABLE_DIR=

# Opcional: o teu fuso horário. Só conta se escolheres "A minha hora" no limite de dados
# (por defeito o limite segue a hora de França, como o 1fichier)
# TZ=Europe/Lisbon

# Opcional: downloads em simultâneo (defeito: 2)
# MAX_PARALLEL=2
